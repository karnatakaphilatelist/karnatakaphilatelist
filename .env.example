# Copy this file to .env.local and fill in the values from
# Supabase Dashboard -> Project Settings -> API.
# Both values are safe to expose to the browser (row level security protects the data).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# MapTiler API key for map tiles (recommended for production — faster + reliable than free OSM).
# Get a free key at https://cloud.maptiler.com/account/keys/
# Without this key, the app falls back to the free OSM tile server (fine for development).
NEXT_PUBLIC_MAPTILER_KEY=
